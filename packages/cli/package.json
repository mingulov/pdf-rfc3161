{
    "name": "pdf-rfc3161-cli",
    "version": "0.3.0",
    "description": "Command-line interface for pdf-rfc3161",
    "keywords": [
        "pdf",
        "timestamp",
        "rfc3161",
        "tsa",
        "cli"
    ],
    "homepage": "https://github.com/mingulov/pdf-rfc3161#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mingulov/pdf-rfc3161.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/mingulov/pdf-rfc3161/issues"
    },
    "license": "MIT",
    "author": "Denis Mingulov <denis@mingulov.com>",
    "type": "module",
    "sideEffects": [
        "./dist/cli.cjs"
    ],
    "bin": {
        "pdf-rfc3161": "dist/cli.cjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "start": "tsx src/cli.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src scripts --fix",
        "prepack": "pnpm run build"
    },
    "dependencies": {
        "asn1js": "^4.0.0",
        "commander": "^15.0.0",
        "pdf-rfc3161": "workspace:*",
        "pkijs": "^4.0.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "^10.14.0",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
