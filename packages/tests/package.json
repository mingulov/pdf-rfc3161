{
    "name": "pdf-rfc3161-tests",
    "private": true,
    "version": "0.2.0",
    "description": "Tests for pdf-rfc3161 ecosystem",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:interoperability": "tsx scripts/offline-pades-conformance.ts",
        "test:conformance": "tsx scripts/offline-pades-conformance.ts",
        "install:pades-oracles": "tsx scripts/install-pades-oracles.ts",
        "assert:pades-oracles": "tsx scripts/assert-pades-oracles.ts",
        "test:package": "tsx scripts/test-packed-consumer.ts --",
        "test:integration": "vitest run test/integration",
        "test:robustness": "tsx scripts/test-robustness.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint test scripts/test-packed-consumer.ts scripts/local-tsa-fixture.ts scripts/packed-consumer-path.ts scripts/pades-oracles.ts scripts/install-pades-oracles.ts scripts/assert-pades-oracles.ts scripts/release-metadata.ts --fix"
    },
    "dependencies": {
        "asn1js": "^3.0.10",
        "commander": "^15.0.0",
        "pdf-lib-incremental-save": "1.17.4",
        "pdf-rfc3161": "workspace:*",
        "pdf-rfc3161-cli": "workspace:*",
        "pkijs": "^3.4.0",
        "pvutils": "^1.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.10.0",
        "pdf-lib": "^1.17.1",
        "tsx": "^4.23.13",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "verifiedby": "0.1.0",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
