{
    "name": "pdf-rfc3161-monorepo",
    "private": true,
    "packageManager": "pnpm@10.30.3",
    "description": "Monorepo for pdf-rfc3161 ecosystem",
    "scripts": {
        "build": "pnpm -r run build",
        "dev": "pnpm -r run dev",
        "test": "pnpm -r run test",
        "lint": "pnpm -r run lint",
        "format": "pnpm -r run format",
        "typecheck": "pnpm -r run typecheck",
        "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
        "cli": "tsx packages/cli/src/cli.ts",
        "test:full": "pnpm run test && pnpm --filter pdf-rfc3161-tests run test:robustness && pnpm --filter pdf-rfc3161-demo run test:e2e"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.9.1",
        "eslint-plugin-security": "^4.0.1",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0"
    },
    "engines": {
        "node": ">=20.19.0",
        "pnpm": ">=10.0.0"
    },
    "pnpm": {
        "overrides": {
            "eslint": "10.9.1",
            "typescript-eslint": "8.68.0",
            "@typescript-eslint/tsconfig-utils": "8.68.0",
            "@typescript-eslint/types": "8.68.0"
        }
    }
}
