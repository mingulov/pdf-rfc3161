{
    "name": "pdf-rfc3161-monorepo",
    "private": true,
    "packageManager": "pnpm@12.3.4",
    "description": "Monorepo for pdf-rfc3161 ecosystem",
    "scripts": {
        "build": "pnpm -r run build",
        "dev": "pnpm -r run dev",
        "test": "pnpm -r run test",
        "lint": "pnpm -r run lint",
        "format": "pnpm -r run format",
        "typecheck": "pnpm -r run typecheck",
        "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
        "cli": "tsx packages/cli/src/cli.ts",
        "test:full": "pnpm run test && pnpm --filter pdf-rfc3161-tests run test:robustness && pnpm --filter pdf-rfc3161-tests run test:package && pnpm --filter pdf-rfc3161-demo run test:e2e"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.2",
        "@eslint/js": "^10.0.1",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "^10.10.0",
        "eslint-plugin-security": "^4.0.1",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "tsx": "^4.23.13",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.69.0"
    },
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=12.0.0"
    }
}
