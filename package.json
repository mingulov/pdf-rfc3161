{
    "name": "pdf-rfc3161-monorepo",
    "private": true,
    "packageManager": "pnpm@12.14.0",
    "description": "Monorepo for pdf-rfc3161 ecosystem",
    "scripts": {
        "build": "pnpm -r run build",
        "dev": "pnpm -r run dev",
        "test": "pnpm -r run test",
        "lint": "pnpm -r run lint",
        "format": "pnpm -r run format",
        "typecheck": "pnpm -r run typecheck",
        "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
        "cli": "tsx packages/cli/src/cli.ts",
        "test:full": "pnpm run test && pnpm --filter pdf-rfc3161-tests run test:robustness && pnpm --filter pdf-rfc3161-tests run test:package && pnpm --filter pdf-rfc3161-tests run test:browser:package && pnpm --filter pdf-rfc3161-demo run test:e2e",
        "mutation": "stryker run",
        "mutation:dry-run": "stryker run --dryRunOnly"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@stryker-mutator/core": "10.0.0",
        "@stryker-mutator/typescript-checker": "10.0.0",
        "@stryker-mutator/vitest-runner": "10.0.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "^10.13.0",
        "eslint-plugin-security": "^4.2.0",
        "prettier": "^3.9.10",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.71.2"
    },
    "engines": {
        "node": ">=22.18.0",
        "pnpm": ">=12.0.0"
    }
}
